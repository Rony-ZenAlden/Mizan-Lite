    "@types/node": "26.1.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
