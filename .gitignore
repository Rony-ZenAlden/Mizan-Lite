# Binaries & build output (root-anchored so they don't match source dirs like tools/archlint/)
/bin/
/build/bin/
# Release artefacts: .exe, installer, .dmg — built, never committed.
/dist/
*.exe
*.out
/mizan
/archlint
/Mizan ERP
# `go build ./cmd/demoseed` from the root drops a 13MB binary here. Built, never committed.
/demoseed

# Go
/vendor/
*.test
*.prof
coverage.out
coverage.html

# Wails
frontend/dist/
frontend/node_modules/
frontend/wailsjs/
# `wails build` caches the hash of package.json to decide whether to reinstall.
frontend/package.json.md5

# Phase 0 ignored `/build/appicon.png` and `/build/darwin/` as stock Wails scaffolding, with a
# note: "Phase 10 is where the real icon and a customised Info.plist become tracked assets —
# REMOVE THESE TWO LINES THEN, or the customisation will be silently ignored."
#
# 10.7 is that moment, and the note was right about the consequence. The bundle identifier was
# corrected from `com.wails.mizan-erp` to `com.mizanerp.desktop` in `build/darwin/Info.plist`,
# and had these lines stayed, the fix would have lived in an untracked file that `wails build`
# regenerates — present on this machine, absent from the repository, and gone on the next clean
# checkout.
#
# A note left in an ignore file for a future phase is only as good as somebody reading it. This
# one was found by `git status` failing to show a file that had definitely been edited.

# Node
node_modules/
npm-debug.log*
.vite/

# Databases & backups (never commit customer data)
*.db
*.db-wal
*.db-shm
# L8 D-L8.6: the upgrade matrix's fixture shops, one per past schema — committed on purpose.
!/internal/lite/bootstrap/testdata/schemas/*.db
*.mizanbak
/data/

# Local env & editor
.env
.env.local
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Placeholder from initial workspace
/hey.htm

# keep a dist placeholder so go:embed compiles before a frontend build
!frontend/dist/
frontend/dist/*
!frontend/dist/index.html

# tsc build cache
*.tsbuildinfo

# pgregory.net/rapid writes a reproduction file when a property test fails.
# It is a local debugging artifact for one machine's failing seed, not a fixture.
testdata/rapid/

# The WebView2 Evergreen Standalone Installer (~200MB), fetched by scripts/fetch-webview2.sh.
#
# Embedded in the Windows installer so it needs no network on the machine it installs onto. NOT
# committed: a binary that size makes the repository unclonable on a slow connection, and it is
# reproducible from one Microsoft link with a size and format check.
#
# `scripts/package-windows.sh` refuses to build without it, so its absence is loud rather than a
# quietly network-dependent installer.
/build/windows/webview2/

# ── Mizan Lite (apps/lite) ─────────────────────────────────────────────────────
# The same shapes as the root Wails project above, anchored to the second project.
/apps/lite/build/bin/
/apps/lite/frontend/node_modules/
/apps/lite/frontend/wailsjs/
/apps/lite/frontend/package.json.md5
# Keep a dist placeholder so `go:embed all:frontend/dist` compiles before a frontend build.
/apps/lite/frontend/dist/*
!/apps/lite/frontend/dist/index.html
# L8: the journeys' screenshots and reports. `make lite-e2e` produces them on any machine; the
# visual pack is looked at, not diffed. (The packages land in /dist, ignored at the top.)
/build/lite-e2e/
/apps/lite/frontend/playwright-report/
/apps/lite/frontend/test-results/

# ── Publishing hygiene (2026-09-25, before the repository goes public) ─────────────
# Installers and disk images wherever a build leaves them; /dist/ above already holds the release folder.
*.dmg
*.msi
*.pkg
*.appx
# More database shapes and their side files. Never a shop's data in the repository (the *.db rules above keep
# the upgrade matrix's fixtures).
*.sqlite
*.sqlite3
*.db-journal
# A Mizan Lite backup's manifest, beside the .db it describes.
*.db.json
# Logs and tool caches.
*.log
.eslintcache
.cache/
coverage/
# A local Go workspace is one developer's layout, not the project's.
go.work
go.work.sum
# macOS and Windows file-system noise.
._*
.AppleDouble
.Spotlight-V100
.Trashes
desktop.ini
