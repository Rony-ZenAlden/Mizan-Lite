{
  "code": "generic_trading",
  "name": "General trading",
  "description": "The postings a shop that buys and sells goods makes. Written as data, so a different country or trade is a different file rather than a different build.",
  "rules": [
    {
      "code": "sale_revenue",
      "event": "sales.invoice.posted",
      "sequence": 1,
      "description": "A sale: the customer owes us the total; the net is revenue and the tax is owed to the authority.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:AR",
          "amount": "document.total",
          "memo": "sale"
        },
        {
          "side": "credit",
          "account": "mapping:SALES",
          "amount": "document.net",
          "memo": "revenue"
        },
        {
          "side": "credit",
          "account": "mapping:TAX_PAYABLE",
          "amount": "document.tax",
          "memo": "tax on sale"
        }
      ]
    },
    {
      "code": "sale_cost",
      "event": "sales.invoice.posted",
      "sequence": 2,
      "description": "The same sale's cost: goods leave stock and become an expense. A separate rule because it is a separate fact — a shop that does not track stock simply omits the cost amount and this rule posts nothing.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:COGS",
          "amount": "document.cost",
          "memo": "cost of goods sold"
        },
        {
          "side": "credit",
          "account": "mapping:INVENTORY",
          "amount": "document.cost",
          "memo": "stock released"
        }
      ]
    },
    {
      "code": "sale_credit_revenue",
      "event": "sales.credit_note.posted",
      "sequence": 1,
      "description": "A return: the customer no longer owes the total, the revenue is reversed, and the tax is no longer owed to the authority. A SEPARATE event from a sale rather than an invoice with negative amounts, because the engine refuses negatives — a negative would flip a line's side silently, and 'debit XOR credit, both non-negative' is what makes an entry checkable.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:SALES",
          "amount": "document.net",
          "memo": "revenue reversed"
        },
        {
          "side": "debit",
          "account": "mapping:TAX_PAYABLE",
          "amount": "document.tax",
          "memo": "tax on return"
        },
        {
          "side": "credit",
          "account": "mapping:AR",
          "amount": "document.total",
          "memo": "credited to customer"
        }
      ]
    },
    {
      "code": "sale_credit_cost",
      "event": "sales.credit_note.posted",
      "sequence": 2,
      "description": "The same return's cost: goods come back into stock and the expense is reversed. Costed at the ORIGINAL sale's cost (§D.3), which is why the credit note line names the sale line it reverses — returning an item bought at last year's price at today's cost would invent profit out of a customer changing their mind.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:INVENTORY",
          "amount": "document.cost",
          "memo": "stock returned"
        },
        {
          "side": "credit",
          "account": "mapping:COGS",
          "amount": "document.cost",
          "memo": "cost of sale reversed"
        }
      ]
    },
    {
      "code": "goods_receipt",
      "event": "purchasing.receipt.confirmed",
      "sequence": 1,
      "description": "Goods arrived before the invoice: stock rises and we accrue what we will owe. GRNI is cleared by the bill, so this entry and that one net to nothing when they agree.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:INVENTORY",
          "amount": "document.net",
          "memo": "stock received"
        },
        {
          "side": "credit",
          "account": "mapping:GRNI",
          "amount": "document.net",
          "memo": "awaiting the supplier's invoice"
        }
      ]
    },
    {
      "code": "purchase",
      "event": "purchasing.bill.posted",
      "sequence": 1,
      "description": "A supplier's invoice for goods already received: it clears EXACTLY what the receipts accrued to GRNI, corrects the cost of goods still on the shelf, books the correction for goods already sold, claims the recoverable tax, and owes the supplier the total. At most two of the four variance lines are ever non-zero; the rest resolve to nothing and are skipped.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:GRNI",
          "amount": "document.accrued",
          "memo": "clears goods received not invoiced"
        },
        {
          "side": "debit",
          "account": "mapping:INVENTORY",
          "amount": "document.variance_stock_over",
          "memo": "goods on hand cost more than we thought"
        },
        {
          "side": "credit",
          "account": "mapping:INVENTORY",
          "amount": "document.variance_stock_under",
          "memo": "goods on hand cost less than we thought"
        },
        {
          "side": "debit",
          "account": "mapping:INVENTORY_ADJUSTMENT",
          "amount": "document.variance_expense_over",
          "memo": "goods already sold cost more than we charged"
        },
        {
          "side": "credit",
          "account": "mapping:INVENTORY_ADJUSTMENT",
          "amount": "document.variance_expense_under",
          "memo": "goods already sold cost less than we charged"
        },
        {
          "side": "debit",
          "account": "mapping:TAX_RECEIVABLE",
          "amount": "document.tax",
          "memo": "recoverable tax"
        },
        {
          "side": "credit",
          "account": "mapping:AP",
          "amount": "document.total",
          "memo": "supplier"
        }
      ]
    },
    {
      "code": "customer_payment_cash",
      "event": "sales.payment.cash.received",
      "sequence": 1,
      "description": "A customer pays in cash: the till rises, what they owe falls. One rule PER METHOD rather than one for all payments — cash goes to the till and a card goes to the bank, and the first version of this file debited CASH for both. Sales publishes the method as part of the action and names no account (§20.3).",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:CASH",
          "amount": "document.total",
          "memo": "payment received"
        },
        {
          "side": "credit",
          "account": "mapping:AR",
          "amount": "document.total",
          "memo": "settles invoice"
        }
      ]
    },
    {
      "code": "customer_payment_card",
      "event": "sales.payment.card.received",
      "sequence": 1,
      "description": "A card payment: the money reaches the bank, not the till. A business whose card settlements land in a separate clearing account changes this line, not the code.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:BANK",
          "amount": "document.total",
          "memo": "payment received"
        },
        {
          "side": "credit",
          "account": "mapping:AR",
          "amount": "document.total",
          "memo": "settles invoice"
        }
      ]
    },
    {
      "code": "customer_payment_bank",
      "event": "sales.payment.bank_transfer.received",
      "sequence": 1,
      "description": "A bank transfer.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:BANK",
          "amount": "document.total",
          "memo": "payment received"
        },
        {
          "side": "credit",
          "account": "mapping:AR",
          "amount": "document.total",
          "memo": "settles invoice"
        }
      ]
    },
    {
      "code": "customer_payment_cheque",
      "event": "sales.payment.cheque.received",
      "sequence": 1,
      "description": "A cheque. Booked to the bank on receipt; a business that tracks uncleared cheques separately points this at its own account.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:BANK",
          "amount": "document.total",
          "memo": "payment received"
        },
        {
          "side": "credit",
          "account": "mapping:AR",
          "amount": "document.total",
          "memo": "settles invoice"
        }
      ]
    },
    {
      "code": "landed_cost",
      "event": "purchasing.landed_cost.applied",
      "sequence": 1,
      "description": "Freight, customs or clearing added to what the stock cost. It raises the inventory value and owes whoever charged it — the goods really did cost the invoice plus the lorry, and a margin computed without it looks healthy and is not.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:INVENTORY",
          "amount": "document.variance_stock_over",
          "memo": "added to the cost of goods on hand"
        },
        {
          "side": "debit",
          "account": "mapping:INVENTORY_ADJUSTMENT",
          "amount": "document.variance_expense_over",
          "memo": "charge on goods already sold"
        },
        {
          "side": "credit",
          "account": "mapping:AP",
          "amount": "document.total",
          "memo": "carrier or agent"
        }
      ]
    },
    {
      "code": "supplier_return",
      "event": "purchasing.return.posted",
      "sequence": 1,
      "description": "Goods go back to a supplier: what we owe them falls by what they charged, the recoverable tax we claimed is given back, and the stock leaves at what the original delivery cost. Any difference between the two is a real gain or loss on the return, not an error.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:AP",
          "amount": "document.total",
          "memo": "debit note to the supplier"
        },
        {
          "side": "credit",
          "account": "mapping:TAX_RECEIVABLE",
          "amount": "document.tax",
          "memo": "recoverable tax given back"
        },
        {
          "side": "credit",
          "account": "mapping:INVENTORY",
          "amount": "document.cost",
          "memo": "goods leave at the original delivery's cost"
        },
        {
          "side": "debit",
          "account": "mapping:INVENTORY_ADJUSTMENT",
          "amount": "document.variance_expense_over",
          "memo": "returned for less than they cost"
        },
        {
          "side": "credit",
          "account": "mapping:INVENTORY_ADJUSTMENT",
          "amount": "document.variance_expense_under",
          "memo": "returned for more than they cost"
        }
      ]
    },
    {
      "code": "supplier_payment",
      "event": "purchasing.payment.made",
      "sequence": 1,
      "description": "We pay a supplier: what we owe falls, cash falls.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:AP",
          "amount": "document.total",
          "memo": "settles bill"
        },
        {
          "side": "credit",
          "account": "mapping:CASH",
          "amount": "document.total",
          "memo": "payment made"
        }
      ]
    },
    {
      "code": "stock_increase",
      "event": "inventory.stock.increased",
      "sequence": 1,
      "description": "Stock found: an adjustment in, or a count that discovered more than the books said. Inventory rises and the gain offsets the adjustment account. A SEPARATE event from a decrease because the posting engine refuses a negative amount — a negative would flip the side silently, and the ledger's 'debit XOR credit, both non-negative' rule is what makes an entry checkable.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:INVENTORY",
          "amount": "document.total",
          "memo": "stock found"
        },
        {
          "side": "credit",
          "account": "mapping:INVENTORY_ADJUSTMENT",
          "amount": "document.total",
          "memo": "adjustment gain"
        }
      ]
    },
    {
      "code": "stock_decrease",
      "event": "inventory.stock.decreased",
      "sequence": 1,
      "description": "Stock lost: an adjustment out, a count shortfall, or shrinkage. The loss is an expense and inventory falls.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:INVENTORY_ADJUSTMENT",
          "amount": "document.total",
          "memo": "adjustment loss"
        },
        {
          "side": "credit",
          "account": "mapping:INVENTORY",
          "amount": "document.total",
          "memo": "stock written off"
        }
      ]
    },
    {
      "code": "cash_short",
      "event": "pos.cash.short",
      "sequence": 1,
      "description": "A till closed with less money than the system expected. The shortfall is an expense and the cash account is reduced to what was actually counted. A SEPARATE event from an overage because the engine refuses negative amounts.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:ROUNDING_DIFF",
          "amount": "document.total",
          "memo": "till short"
        },
        {
          "side": "credit",
          "account": "mapping:CASH",
          "amount": "document.total",
          "memo": "cash adjusted to count"
        }
      ]
    },
    {
      "code": "cash_over",
      "event": "pos.cash.over",
      "sequence": 1,
      "description": "A till closed with more money than expected. Cash rises to what was counted, and the overage offsets. A business that tracks till differences in a dedicated account points both these rules at it — no code changes.",
      "lines": [
        {
          "side": "debit",
          "account": "mapping:CASH",
          "amount": "document.total",
          "memo": "cash adjusted to count"
        },
        {
          "side": "credit",
          "account": "mapping:ROUNDING_DIFF",
          "amount": "document.total",
          "memo": "till over"
        }
      ]
    }
  ]
}
