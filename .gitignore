# Binaries & build output (root-anchored so they don't match source dirs like tools/archlint/)
/bin/
/build/bin/
# Release artefacts: .exe, installer, .dmg — built, never committed.
/dist/
*.exe
*.out
/mizan
/archlint
/Mizan ERP

# Go
/vendor/
*.test
*.prof
coverage.out
coverage.html

# Wails
frontend/dist/
frontend/node_modules/
frontend/wailsjs/
# `wails build` caches the hash of package.json to decide whether to reinstall.
frontend/package.json.md5

# Stock Wails scaffolding, regenerated on demand by `wails build`: the placeholder
# logo and a templated Info.plist. Ignored rather than committed because tracking
# the default Wails logo would read as a deliberate branding choice it is not.
# Phase 10 (polish / installers) is where the real icon and a customised Info.plist
# become tracked assets — REMOVE THESE TWO LINES THEN, or the customisation will be
# silently ignored.
/build/appicon.png
/build/darwin/

# Node
node_modules/
npm-debug.log*
.vite/

# Databases & backups (never commit customer data)
*.db
*.db-wal
*.db-shm
*.mizanbak
/data/

# Local env & editor
.env
.env.local
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Placeholder from initial workspace
/hey.htm

# keep a dist placeholder so go:embed compiles before a frontend build
!frontend/dist/
frontend/dist/*
!frontend/dist/index.html

# tsc build cache
*.tsbuildinfo

# pgregory.net/rapid writes a reproduction file when a property test fails.
# It is a local debugging artifact for one machine's failing seed, not a fixture.
testdata/rapid/
