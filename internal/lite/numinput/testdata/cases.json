{
  "comment": "The ONE contract for typed numbers. Read by internal/lite/numinput (Go) and by apps/lite/frontend/src/i18n/numbers.test.ts (TypeScript). A case added here is enforced on both. `output` is the normalised string; `error` is the code the input is refused with. `quantities` adds a unit's input decimals: Go's stock/domain.ParseQuantity and the frontend's quantityProblem refuse the same inputs with the same code.",
  "normalise": [
    { "input": "3.25", "output": "3.25" },
    { "input": "45000", "output": "45000" },
    { "input": "١٫٧٥٠", "output": "1.750" },
    { "input": "١.٧٥٠", "output": "1.750" },
    { "input": "۱.۵", "output": "1.5" },
    { "input": "۱٫۵", "output": "1.5" },
    { "input": "٤٥٠٠٠", "output": "45000" },
    { "input": "  3.25  ", "output": "3.25" },
    { "input": "\t١٦\n", "output": "16" },
    { "input": ".5", "output": "0.5" },
    { "input": "5.", "output": "5" },
    { "input": "0", "output": "0" },
    { "input": "007", "output": "007" },
    { "input": "1٢3", "output": "123" },
    { "input": "1,750", "error": "lite.number.grouping" },
    { "input": "١٬٧٥٠", "error": "lite.number.grouping" },
    { "input": "٣،٥", "error": "lite.number.grouping" },
    { "input": "", "error": "lite.number.invalid" },
    { "input": "   ", "error": "lite.number.invalid" },
    { "input": ".", "error": "lite.number.invalid" },
    { "input": "1.2.3", "error": "lite.number.invalid" },
    { "input": "١٫٢٫٣", "error": "lite.number.invalid" },
    { "input": "-5", "error": "lite.number.invalid" },
    { "input": "+5", "error": "lite.number.invalid" },
    { "input": "1e3", "error": "lite.number.invalid" },
    { "input": "1 000", "error": "lite.number.invalid" },
    { "input": "abc", "error": "lite.number.invalid" },
    { "input": "$3", "error": "lite.number.invalid" },
    { "input": "123456789012345678901234567890123", "error": "lite.number.invalid" }
  ],
  "quantities": [
    { "input": "12.5", "decimals": 3 },
    { "input": "١٢٫٥٠٠", "decimals": 3 },
    { "input": "0.001", "decimals": 3 },
    { "input": "12.5005", "decimals": 3, "error": "lite.stock.quantity_decimals" },
    { "input": "3", "decimals": 0 },
    { "input": "٣", "decimals": 0 },
    { "input": "1.5", "decimals": 0, "error": "lite.stock.quantity_decimals" },
    { "input": "3.0", "decimals": 0, "error": "lite.stock.quantity_decimals" },
    { "input": "3.", "decimals": 0 },
    { "input": "1,5", "decimals": 3, "error": "lite.number.grouping" },
    { "input": "-2", "decimals": 3, "error": "lite.number.invalid" },
    { "input": "", "decimals": 0, "error": "lite.number.invalid" }
  ],
  "latinDigits": [
    { "input": "٦٢٢٣٠٠٠١١٢٣٤٥", "output": "6223000112345" },
    { "input": "۶۲۲۳", "output": "6223" },
    { "input": " ABC-١٢٣ ", "output": "ABC-123" },
    { "input": "", "output": "" }
  ]
